# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Your Telegram user ID (send /myid to @userinfobot to get it)
AUTHORIZED_USER_ID=123456789

# Local API port for TUI (default: 7777)
API_PORT=7777

# Copilot model used for all Copilot SDK sessions (default: claude-sonnet-4.6)
COPILOT_MODEL=claude-sonnet-4.5

# Maximum age of an incoming Feishu message event to process, in milliseconds.
# Older messages are marked processed and dropped silently so service recovery
# does not replay stale user input (default: 3600000 = 1 hour).
FEISHU_MESSAGE_MAX_AGE_MS=3600000

# Delay before the first Feishu "Copilot is still responding" notice, in
# milliseconds. Keeps fast replies quiet while surfacing slow turns (default: 7000).
FEISHU_THINKING_INITIAL_DELAY_MS=7000

# Interval between repeated Feishu progress notices while Copilot is still
# responding, in milliseconds. Each notice includes elapsed duration (default: 120000 = 2 minutes).
FEISHU_THINKING_INTERVAL_MS=120000
